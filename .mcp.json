{
	"mcpServers": {
		"next-devtools": {
			"command": "npx",
			"args": ["-y", "next-devtools-mcp@latest"]
		},
		"dsfr": {
			"command": "npx",
			"args": ["dsfr-mcp"]
		},
		"figma": {
			"type": "http",
			"url": "https://mcp.figma.com/mcp"
		},
		"playwright": {
			"command": "npx",
			"args": ["-y", "@playwright/mcp@latest"]
		},
		"ultra11y": {
			"command": "pnpm",
			"args": ["--dir", "packages/app", "exec", "ultra11y", "mcp"]
		}
	}
}
