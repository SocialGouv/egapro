{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(*--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(*--no-gpg-sign*)",
      "Bash(*commit.gpgsign=false*)",
      "Bash(*commit.gpgSign=false*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/packages/app/node_modules/ultra11y/hooks/pre-tool-use.mjs\"; [ -f \"$f\" ] && node \"$f\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
