{
  "env": {
    "EPIC_MAX_PARALLEL": "5",
    "EPIC_DEFAULT_BASE": "origin/chore/ai-pipeline"
  },
  "extraKnownMarketplaces": {
    "ultra11y": {
      "source": {
        "source": "github",
        "repo": "maxgfr/ultra11y"
      }
    }
  },
  "enabledPlugins": {
    "ultra11y@ultra11y": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-pr-reviews.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-bad-patterns.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-lint.sh"
          }
        ]
      }
    ]
  }
}
