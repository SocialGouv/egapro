/node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# DSFR assets (generated by scripts/copy-dsfr.js)
/public/dsfr

# Swagger UI assets (generated by scripts/copy-swagger-ui.mjs)
/public/swagger-ui

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

# test-results
/test-results

# playwright grid report (runtime artifact; regenerated by test:e2e:grille — #4022)
/playwright-report

# lighthouse ci
/.lighthouseci

# playwright auth state
src/e2e/.auth/

# ultra11y a11y audit artifacts (runtime output + scan session state)
/audits
/.auth
# `/.ultra11y/*` et non `/.ultra11y` : git ne descend pas dans un répertoire ignoré, donc une
# exception à l'intérieur ne peut pas s'appliquer. On ignore le CONTENU, ce qui laisse la porte
# ouverte au seul fichier qui doit être versionné.
/.ultra11y/*
# Le registre de verdicts n'est pas un artefact de run : c'est une affirmation datée sur ce
# dépôt (« ce critère est conforme, voici la preuve citée »), que la CI rejoue pour rendre la
# grille complète sans modèle. Versionné exprès, donc relu en revue comme le reste du code.
# Sous `/.ultra11y` ignoré en bloc, le registre serait resté vide et la CI aurait silencieusement
# retombé sur « à évaluer » — la panne exacte que ce modèle supprime.
!/.ultra11y/verdicts/
/.ultra11y/verdicts/*
!/.ultra11y/verdicts/*.json
# Même raisonnement pour la liste des critères déclarés indécidables : c'est une affirmation
# sur CE code (« personne ne peut trancher ce critère, et voici pourquoi »), elle doit passer
# en revue avec lui. La garder hors du dépôt reviendrait à laisser une exception d'audit vivre
# sans relecture — exactement ce que la porte de complétude existe pour empêcher.
!/.ultra11y/undecidable.json
