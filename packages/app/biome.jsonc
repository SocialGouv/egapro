{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git"
	},
	"files": {
		// `.ultra11y/` est entièrement de la sortie de run — captures, état de scan, rapports —
		// et le moteur écrit du JSON à 2 espaces là où ce dépôt formate en tabulations. Biome suit
		// .gitignore, qui ignore désormais tout le répertoire, mais l'exclusion reste explicite :
		// un run local laisse ces fichiers sur le disque, et `format` ne doit pas les réécrire.
		// `.impeccable/` relève du même cas : le hook de la skill le réécrit à chaque
		// édition de .tsx, en JSON à 2 espaces. Il est gitignoré, mais un run local
		// laisse le cache sur le disque et faisait échouer `format:check`.
		"includes": ["**", "!**/.ultra11y", "!**/.impeccable"]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"recommended": true,
			"source": {
				"recommended": true,
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "cn"]
					}
				}
			}
		}
	},
	"overrides": [
		{
			// `list-style: none` fait perdre à WebKit la sémantique de liste (Safari/VoiceOver) :
			// `role="list"` est le contournement documenté (bugs.webkit.org/show_bug.cgi?id=259487),
			// donc légitimement « redondant » pour Biome, uniquement sur ce composant.
			"includes": ["src/modules/my-space/StepRows.tsx"],
			"linter": {
				"rules": {
					"a11y": {
						"noRedundantRoles": "off"
					}
				}
			}
		}
	],
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	}
}
