AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000/api/auth"
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/egapro"
# Dedicated PG for the notifications queue — isolated from the main DB so a
# crash of the main infra does not lose pending notification jobs.
NOTIFICATIONS_DATABASE_URL="postgresql://postgres:postgres@localhost:5439/egapro_notifications"
# Optional locally — leave empty and the ProConnect provider is simply not
# registered. Required in production: the app refuses to start without them.
EGAPRO_PROCONNECT_CLIENT_ID=""
EGAPRO_PROCONNECT_CLIENT_SECRET=""
EGAPRO_PROCONNECT_ISSUER=""
# Dev-only sign-in at /dev-login, bypassing ProConnect. Accepts only "true" or
# "false", and only on a loopback host outside production. scripts/setup-worktree.sh
# turns it on for the worktrees it provisions.
EGAPRO_DEV_AUTH="false"
EGAPRO_WEEZ_API_URL=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Release identifier shown in the footer (issue #4020): git tag in production,
# branch name on review apps. Inlined at build time via a BuildKit secret in the
# Dockerfile — leave unset for local dev (the footer then hides the version).
NEXT_PUBLIC_APP_VERSION=""
# Pull-request number for the footer's PR link on review apps. Resolved from the
# commit SHA in the review workflows; unset everywhere else.
NEXT_PUBLIC_PR_NUMBER=""
# Local Matomo (docker compose) — see scripts/matomo-local/README.md.
# Points at the local stack on :8080, site 1 (provisioned by `matomo-init`).
NEXT_PUBLIC_MATOMO_URL="http://localhost:8080"
NEXT_PUBLIC_MATOMO_SITE_ID="1"
# Server-side Matomo Reporting API for the admin stats widgets (issue #3646).
# Optional: the admin charts degrade to "no data" when MATOMO_API_TOKEN is unset.
# The token is generated by `matomo-init` into scripts/matomo-local/.secrets/token
# — copy it here. MATOMO_API_URL falls back to NEXT_PUBLIC_MATOMO_URL when empty.
MATOMO_API_TOKEN=""
MATOMO_API_URL=""
# Bearer token expected by POST /api/gip-mds/import (the K8s CronJob sends it).
# Required: the route fails closed and answers 401 when this is unset, so a
# forgotten secret can never leave the import endpoint unauthenticated.
EGAPRO_GIP_MDS_API_TOKEN="dev-gip-import-token"
# Source of the GIP MDS file. Defaults to the local mock; point it at SUIT to
# test the real import (requires the client certificate below — the certificate
# is attached only when this URL is on the EGAPRO_SUIT_API_URL origin):
#   https://api.suit.valid.travail.gouv.fr/suit/api/externe/egapro/gipmds/latest
EGAPRO_GIP_MDS_API_URL="http://localhost:3000/api/gip-mds/mock"
# SUIT API base URL. dev and preprod point at SUIT Validation
# (https://api.suit.valid.travail.gouv.fr), production at the production
# instance. Use the Validation one locally — that is what the test certificate
# is issued for.
EGAPRO_SUIT_API_URL=""
# Client certificate for the SUIT API (mTLS), required by its validation
# environment. Generate both lines below with:
#   pnpm --filter app suit:encode-cert path/to/cert.p12
# Optional: leave both empty locally — SUIT calls then go out without a client
# certificate, exactly as before. Never commit a real certificate.
EGAPRO_SUIT_CLIENT_CERT_P12_BASE64=""
EGAPRO_SUIT_CLIENT_CERT_PASSWORD=""
# « Je donne mon avis » (jedonnemonavis.numerique.gouv.fr) — démarche + button IDs.
# Optional: default to 4169 / 4730 when unset.
EGAPRO_JDMA_DEMARCHE_ID="4169"
EGAPRO_JDMA_BUTTON_ID="4730"
# Shared secret injected by the APISIX gateway (X-Gateway-Forwarded header)
# and verified by src/middleware.ts on /api/v1/* to prevent in-cluster bypass.
EGAPRO_GATEWAY_SHARED_SECRET="dev-gateway-shared-secret-minimum-32-chars"
NEXT_PUBLIC_EGAPRO_ENV="dev"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="egapro-dev-app"
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"
ADMIN_EMAILS="test@fia1.fr"
MAIL_ENABLED="true"
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="no-reply@egapro.local"
# Valkey cache — optional, app works without it (in-memory fallback)
VALKEY_URL="redis://localhost:6379"
EGAPRO_PUBLIC_API_TOKENS=""
