#!/usr/bin/env bash
#
# Generates the local (dev only) basic-auth file used by the `files` service
# (packages/files/.htpasswd, git-ignored). In deployed environments the file is
# mounted from the `basic-auth` Kubernetes Secret instead (see .kontinuous/values.yaml).
#
# Format: one `user:bcrypt-hash` per line (what `htpasswd -B -C 12` produces). The
# Secret must use bcrypt too (`$2y$`): the server cannot check `$apr1$` (MD5) hashes.
# Usage: scripts/files-htpasswd [user] [password]   (defaults: dev / dev)

set -e

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TARGET="$ROOT_DIR/packages/files/.htpasswd"
USERNAME="${1:-dev}"
PASSWORD="${2:-dev}"

if [ -f "$TARGET" ] && [ -z "$1" ]; then
  exit 0
fi

if command -v htpasswd >/dev/null 2>&1; then
  htpasswd -nbB -C 12 "$USERNAME" "$PASSWORD" | head -n 1 > "$TARGET"
else
  docker run --rm httpd:2-alpine htpasswd -nbB -C 12 "$USERNAME" "$PASSWORD" | head -n 1 > "$TARGET"
fi

echo "Generated $TARGET for user '$USERNAME'"
